APP_NAME="NeatMeet OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0-bootstrap

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: sqlite (default). Docker/production: pgsql
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=neatmeet_os
# DB_USERNAME=neatmeet
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Reverb (day board live updates). Start with: php artisan reverb:start
REVERB_APP_ID=neatmeet-local
REVERB_APP_KEY=neatmeet-local-key
REVERB_APP_SECRET=neatmeet-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@neatmeet.local"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage (MinIO in local Docker)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=neatmeet-os
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Public Next.js origin (no trailing slash). Used for Sanctum, referral share links (/?ref=CODE), and emails.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SANCTUM_TOKEN_EXPIRATION=480

# Integrations — webhook HMAC (Stripe / Mailgun / Twilio)
INTEGRATIONS_WEBHOOK_REQUIRE_SIGNATURE=true
INTEGRATIONS_WEBHOOK_REQUIRE_SECRET=false

# Web Push (VAPID) for member PWA — generate with: php artisan tinker → Minishlink\WebPush\VAPID::createVapidKeys()
VAPID_SUBJECT=mailto:ops@neatmeet.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Queue / scheduler (production): queue:work + schedule:work (or cron schedule:run)
QUEUE_CONNECTION=database

# Cloudflare Turnstile (visible captcha on public/auth writes). Leave empty to skip in local.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_ENABLED=true

# Platform WhatsApp (Genius) — required for member PWA login OTP (and booking WhatsApp).
# Prefer Platform → Settings → WhatsApp in the UI; env is fallback.
# Without a ready Genius session, POST /api/v1/member/login/request-otp fails in non-test envs.
WHATSAPP_PROVIDER=genius
WHATSAPP_GENIUS_API_KEY=
WHATSAPP_GENIUS_SESSION_ID=
WHATSAPP_GENIUS_BASE_URL=https://restapi.geniusdevel.com

# AI Hairstyle Preview (Milestone E) — platform can switch stub ↔ replicate
AI_HAIRSTYLE_PROVIDER=stub
AI_HAIRSTYLE_ALLOW_STUB=true
AI_HAIRSTYLE_TEMP_MAX_AGE_MINUTES=120
AI_HAIRSTYLE_STALE_GENERATING_MINUTES=7
REPLICATE_API_TOKEN=
REPLICATE_AI_HAIRSTYLE_MODEL=zsxkib/instant-id

VITE_APP_NAME="${APP_NAME}"
