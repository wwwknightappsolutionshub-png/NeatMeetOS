NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_TENANT_SLUG=demo-salon
# Public frontend origin (no trailing slash). Used for Open Graph / WhatsApp link previews.
# Must match the live site URL and backend FRONTEND_URL in production.
NEXT_PUBLIC_SITE_URL=https://neatmeet.prohost.cloud

# Laravel Reverb (optional — day board live refresh). Match backend REVERB_* values.
NEXT_PUBLIC_REVERB_APP_KEY=neatmeet-local-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
